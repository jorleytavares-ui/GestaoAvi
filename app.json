{
  "expo": {
    "name": "GestãoAvi",
    "slug": "gestaoavi",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.mauro.gestaoavi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F1ECDD"
      },
      "runtimeVersion": "1.0.0"
    },
    "ios": {
      "bundleIdentifier": "com.mauro.gestaoavi",
      "supportsTablet": true,
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F1ECDD"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d30d59fc-c25a-47d9-a324-6075752cbfe3"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/d30d59fc-c25a-47d9-a324-6075752cbfe3"
    }
  }
}
